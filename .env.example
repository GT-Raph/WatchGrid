# Copy to .env for docker compose. Every value here is an example — generate real
# secrets for any shared or production environment (Appendix B).

DJANGO_SETTINGS_MODULE=config.settings.production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1,watchgrid.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://watchgrid.example.com
# Public base URL used in emailed links (verification, password reset, invitations, alerts).
SITE_URL=http://localhost:8080
# Nginx in front of Django = 1; Nginx behind a load balancer = 2.
TRUSTED_PROXY_COUNT=1
# Both must be true once TLS terminates in front of Nginx; false only for local HTTP trials.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false

POSTGRES_PASSWORD=watchgrid
DATABASE_URL=postgres://watchgrid:watchgrid@postgres:5432/watchgrid
REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WatchGrid <alerts@watchgrid.example.com>

# Monitoring policy
MONITOR_MIN_INTERVAL_SECONDS=60
MONITOR_MAX_TIMEOUT_SECONDS=30
MONITOR_MAX_RESPONSE_BYTES=1048576
SCHEDULER_TICK_SECONDS=15
# Must stay empty in production (the app refuses to start otherwise).
MONITOR_ALLOWED_PRIVATE_NETWORKS=
MONITOR_EXTRA_BLOCKED_NETWORKS=

# Error ingestion
ERROR_EVENT_MAX_BYTES=262144
ERROR_EVENT_SAMPLE_THRESHOLD_PER_MINUTE=120

# Retention (days)
RETENTION_CHECK_DAYS=90
RETENTION_ERROR_EVENT_DAYS=30
RETENTION_NOTIFICATION_DAYS=180
RETENTION_AUDIT_LOG_DAYS=400

LOG_LEVEL=INFO
LOG_FORMAT=json
